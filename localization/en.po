msgid "NEGOTIATION_Retail_SPEAKER"
msgstr "Retailer manager"

msgid "NEGOTIATION_Retail_FIRST_GREETING"
msgstr "Hello. We handle your games at our retailer."

msgid "NEGOTIATION_Retail_GREETING"
msgstr "Welcome back. Thank you for your continued business."

msgid "NEGOTIATION_Retail_QUESTION"
msgstr "You would like to discuss a lower fee. Let me consider it."

msgid "NEGOTIATION_Retail_FAILURE_SUMMARY"
msgstr "The negotiation failed. The retailer has declined a reduction this time."

msgid "LOAD_PREVIOUS_SAVE"
msgstr "Load Previous Save"

msgid "LOAD_PREVIOUS_SAVE_NOTE"
msgstr "The previous valid save is kept when you save again. Loading it restores earlier progress in memory and leaves the current file untouched until you choose Save. It may roll back purchases or dialogue progress."

msgid "EARLY_ACCESS_SCOPE"
msgstr "Early Access: Supported Features"

msgid "EARLY_ACCESS_BOUNDARY"
msgstr "Beginner ends after Year 2, December, week 4. Normal is experimental ongoing play. Negative funds trigger company dissolution in either mode. Original presentation and full campaign parity remain incomplete."

msgid "EARLY_ACCESS_FEATURES"
msgstr "Supported: hiring and desks/PCs; original projects, eligible sequels and manga; meetings, cancellation, debugging and shipment; reviews, sales and reprints; calendar events and loans; school, hot springs, recycling, technology capacity, production capacity, lawyer consultations and mystery-lab experiments; own-console development and launch; casino coins, poker and blackjack; modern saves."

msgid "EARLY_ACCESS_DEFERRED"
msgstr "Unavailable or incomplete: card-chain, horse racing, original save import, full company progression and some original conversation/growth effects. Full native Windows playthrough testing is assigned to the community."

msgid "MYSTERY_LAB_START"
msgstr "Start an experiment"

msgid "MYSTERY_LAB_PROGRESS"
msgstr "Experiment in progress: {0:0.0}%"

msgid "MYSTERY_LAB_LIFECYCLE"
msgstr "Demolishing the lab suspends the experiment. Rebuilding resumes it."

msgid "FACILITY_CONFIRM_MysteryLab"
msgstr "Start an unpredictable experiment for ¥{0:N0}? The fee is charged even if it leaves funds negative."

msgid "FACILITY_RESULT_ExperimentRunning"
msgstr "An experiment is already running."

