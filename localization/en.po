msgid "FINANCIAL_FAILURE"
msgstr "Company dissolution"

msgid "FINANCIAL_FAILURE_INTRO_0"
msgstr "Our cash balance has fallen below zero. We cannot continue operating."

msgid "FINANCIAL_FAILURE_INTRO_1"
msgstr "The company must dissolve. Let us speak with the staff before we close."

