; Engine configuration file.
; OpenGDS2 - community-written compatibility/reimplementation project.
; Original Game Dev Story 2 DX files are not included.

config_version=5

[application]
config/name="Open Game Dev Story II"
config/version="0.1.0-ea.1"
config/icon="res://assets/application-icon.svg"
config/windows_native_icon="res://assets/application-icon.ico"
config/use_custom_user_dir=true
config/custom_user_dir_name="OpenGDS2"
run/main_scene="res://scenes/Main.tscn"

[dotnet]
project/assembly_name="OpenGDS2"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
; The original desktop adds workspace when enlarged; it does not stretch pixels.
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[internationalization]
locale/fallback="en"
locale/translations=PackedStringArray("res://localization/en.po", "res://localization/ja.po")
